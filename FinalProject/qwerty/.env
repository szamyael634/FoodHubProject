DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=qwerty
DB_PORT=3306

# Migration Flag (set to 1 to auto-initialize schema on startup)
MIGRATE=1

# Email Configuration (SMTP for OTP verification and notifications)
# Gmail: Use SMTP app password (not regular password). See: https://myaccount.google.com/apppasswords
# Other providers: Use your SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=briddonpy2004@gmail.com
SMTP_PASS=kovbciudqvlpvnrn
SENDER_NAME=Hub E-Commerce
EMAIL_FROM=noreply@hub-ecommerce.com

# Note: Leave SMTP_USER and SMTP_PASS empty to use dev mode (emails printed to console)

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Application
FLASK_ENV=production
DEBUG=False

