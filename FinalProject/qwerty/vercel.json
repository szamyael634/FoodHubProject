
{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/cart/:path*",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/cart-api/:path*"
    },
    {
      "source": "/api/orders/:path*",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/orders-api/:path*"
    },
    {
      "source": "/api/products/:path*",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/products-api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}