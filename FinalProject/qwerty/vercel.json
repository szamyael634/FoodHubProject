{
  "version": 2,
  "framework": null,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/api/cart/(.*)",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/cart-api/$1"
    },
    {
      "source": "/api/cart",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/cart-api"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/orders-api/$1"
    },
    {
      "source": "/api/orders",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/orders-api"
    },
    {
      "source": "/api/products/(.*)",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/products-api/$1"
    },
    {
      "source": "/api/products",
      "destination": "https://gladttjcpcgpvxdrhqmx.supabase.co/functions/v1/products-api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
