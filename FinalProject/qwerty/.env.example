# ============== APPLICATION SETTINGS ==============

# Environment mode
NEXT_PUBLIC_ENV=dev

# Application URL (for callbacks, emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============== EMAIL CONFIGURATION ==============

# SMTP Server Settings (for transactional emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@hubcommerce.com
EMAIL_FROM_NAME=Hub E-Commerce

# ============== STORAGE/BUCKETS ==============

# Supabase Storage bucket names
STORAGE_BUCKET_PRODUCTS=products
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_DOCUMENTS=documents

# ============== FEATURE FLAGS ==============

NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_MESSAGING=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
