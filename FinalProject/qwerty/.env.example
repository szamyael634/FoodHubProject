# Hub E-Commerce Platform - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============== CRITICAL SECURITY SETTINGS ==============
# MUST be set for production deployment

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-change-in-production

# JWT Secret for token signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=your-jwt-secret-change-in-production

# Environment mode (dev/prod)
ENV=dev

# ============== DATABASE CONFIGURATION ==============

# Database engine compatibility flag. Existing SQL paths still expect mysql-style placeholders,
# while the runtime connection can be pointed at Supabase/Postgres with the variables below.
DB_ENGINE=mysql

# Supabase/Postgres Database Configuration
# Set either SUPABASE_DB_URL or the individual connection fields from your Supabase dashboard.
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# Supabase public client configuration
SUPABASE_URL=https://erinazbvuouefbszenkd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_3ca9AT6xL4ncrzjsprBuTQ_8v6oEZtI
NEXT_PUBLIC_SUPABASE_URL=https://erinazbvuouefbszenkd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3ca9AT6xL4ncrzjsprBuTQ_8v6oEZtI

# Legacy MySQL Configuration (kept only for transition compatibility)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=qwerty

# ============== CORS CONFIGURATION ==============

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# ============== JWT & TOKEN SETTINGS ==============

# Refresh token expiry in days
REFRESH_TOKEN_EXP_DAYS=30

# ============== EMAIL CONFIGURATION ==============

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
EMAIL_FROM=noreply@hubcommerce.com
EMAIL_FROM_NAME=Hub E-Commerce

# ============== PAYMENT GATEWAY ==============

# Payment provider API keys (if applicable)
# PAYMENT_API_KEY=your-payment-api-key
# PAYMENT_SECRET=your-payment-secret

# ============== FILE UPLOAD LIMITS ==============

# Maximum file upload size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880

# ============== OPTIONAL SETTINGS ==============

# Enable debug mode (never use in production!)
DEBUG=False

# Database migration flag
MIGRATE=0

# Debug paths
DEBUG_PATHS=0
